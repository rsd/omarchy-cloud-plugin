[Unit]
Description=rclone mount of %i:
# No network-online.target: the user manager has no such unit, so ordering
# on it does nothing. A mount started before the network is up fails and is
# restarted every RestartSec until it comes up; with no start limit it never
# gives up (one start per 15s could not reach the default limit either).
StartLimitIntervalSec=0

[Service]
Type=notify
# rclone signals READY once the mount is up; a start stuck longer than this
# (an unreachable remote) fails and is retried by Restart=.
TimeoutStartSec=2min
# Defaults suit remotes WITHOUT change polling (S3). Remotes with ChangeNotify
# (Drive, OneDrive) override these in %h/.config/rclone-mount/<remote>.env
# (RCLONE_* environment variables; the file wins over Environment=).
# The tunables live here as Environment=, never as command-line flags: an rclone
# flag beats its environment variable, so a flag would shadow the .env file.
Environment=RCLONE_DIR_CACHE_TIME=5m
Environment=RCLONE_POLL_INTERVAL=1m
Environment=RCLONE_VFS_CACHE_MAX_SIZE=10G
Environment=RCLONE_VFS_CACHE_MAX_AGE=72h
Environment=RCLONE_VFS_WRITE_BACK=1s
EnvironmentFile=-%h/.config/rclone-mount/%i.env
# The mount root: mounts go to ${OMARCHY_CLOUD_ROOT}/<remote>, outside $HOME
# (~/Cloud/<remote> is a symlink to it), so tools that walk the home
# directory do not crawl the network mount. The Environment= below is the
# default; the setting in %h/.config/omarchy-cloud/cloud.env (one
# OMARCHY_CLOUD_ROOT=<path> line, written by install.sh) wins. Change the
# setting only while no mount runs (install.sh --mount-root refuses
# otherwise): ExecStop= must unmount the path ExecStart= mounted.
# %h/.local/bin/rclone-mount guards both steps. It reads cloud.env itself,
# as install.sh, the TUI and the panel do (raw: no quote stripping, no
# whitespace trimming, no backslash processing), and holds the root to their
# rule (tests/fixtures/roots.tsv): absolute, not "/", no empty, "." or ".."
# component, no whitespace, control character, $ % \ " ' or backquote, not
# the home directory (%h, normalised) nor inside it, also with symlinks
# resolved (tests/fixtures/resolved-roots.tsv), at most 255 bytes, valid
# UTF-8 without U+FFFD. The root systemd read (passed as
# ${OMARCHY_CLOUD_ROOT}, one word) must be the same one: systemd parses an
# EnvironmentFile its own way (quotes, whitespace, backslashes, indented
# lines; a line that is not valid UTF-8 is skipped and the default wins),
# and a root the other readers do not see is never mounted.
# A refused root (or remote name) FAILS the unit: ExecStart= exits 78 with
# one line in the journal (the remote, the path, the reason, the fix), and
# RestartPreventExitStatus=78 keeps it from restarting until the setting is
# fixed; so does a non-directory or a symlink where <root>/%i goes. A
# transient failure exits 75 and is restarted by Restart=on-failure: a stale
# FUSE mount at <root>/%i (left by an rclone that died; ExecStart= clears it
# with fusermount3 -uz first, and fails only when that fails), a root that
# cannot be resolved now. A valid root that is not yet an existing directory
# the user can write to and search SKIPS the start: ExecCondition= exits 1
# with one line in the journal (a skipped unit is neither failed nor
# restarted). Nothing
# here creates the root (created once, by the user, when it is a place like
# /mnt): ExecStart= creates only <root>/<remote>, then execs rclone (the
# same PID, so Type=notify works).
Environment=OMARCHY_CLOUD_ROOT=/mnt/cloud
EnvironmentFile=-%h/.config/omarchy-cloud/cloud.env
ExecCondition=%h/.local/bin/rclone-mount check %i ${OMARCHY_CLOUD_ROOT} %h
ExecStart=%h/.local/bin/rclone-mount start %i ${OMARCHY_CLOUD_ROOT} %h -- \
    /usr/bin/rclone mount %i: ${OMARCHY_CLOUD_ROOT}/%i \
    --cache-dir %h/.cache/rclone \
    --vfs-cache-mode full \
    --vfs-read-chunk-size 8M \
    --vfs-read-chunk-size-limit 32M \
    --vfs-read-ahead 8M \
    --buffer-size 4M
ExecStop=/usr/bin/fusermount3 -uz ${OMARCHY_CLOUD_ROOT}/%i
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=15

[Install]
WantedBy=default.target
